# ---- Copy this file to .env.local and fill in real values ----

# Public site URL. Used for canonical tags, sitemap.xml, robots.txt and OG tags.
NEXT_PUBLIC_SITE_URL=https://www.exploreroots.in

# WhatsApp business number in international format, digits only (no + or spaces).
# 91 = India country code.
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# Optional. Leave empty to serve images from /public.
# Set it to a CDN base URL later and every image path flips over automatically.
# Example: https://cdn.exploreroots.in  or  https://res.cloudinary.com/<cloud>/image/upload
NEXT_PUBLIC_IMAGE_CDN_URL=

# Optional analytics / verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
